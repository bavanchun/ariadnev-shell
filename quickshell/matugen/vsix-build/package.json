{
  "name": "advs-theme",
  "displayName": "ADVS - Adv Material Shell Theme",
  "description": "Dynamic theme using matugen & adv16 terminal colors - auto-updated by AriadnevShell",
  "publisher": "AdvLinux",
  "version": "0.0.3",
  "icon": "advlogo.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "advs",
    "adv",
    "material",
    "advshell",
    "ariadnev"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bavanchun/ariadnev-shell"
  },
  "contributes": {
    "themes": [
      {
        "label": "Dynamic Base16 AdvShell",
        "uiTheme": "vs-dark",
        "path": "./themes/advshell-default.json",
        "_watch": true
      },
      {
        "label": "Dynamic Base16 AdvShell (Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/advshell-dark.json",
        "_watch": true
      },
      {
        "label": "Dynamic Base16 AdvShell (Light)",
        "uiTheme": "vs",
        "path": "./themes/advshell-light.json",
        "_watch": true
      }
    ]
  }
}
