# Template file for 'advs-git'
#
# AriadnevShell git development release
#
# NOTE: This template is built exclusively by CI. The workflow stages a local
# source tarball and dynamically patches version, checksum, and distfiles
# before calling xbps-src.  Do not attempt to build this template manually
# without first providing the source archive.
#
# The binary is built with the `distro_binary` build tag (drops the in-app
# self-update command) and `withshell` (embeds the Quickshell UI; the shell
# no longer discovers an installed tree, so an unembedded binary has no UI).
pkgname=advs-git
version=1.4.6.git
revision=1
create_wrksrc=yes
build_style=go
build_wrksrc="core"
hostmakedepends="make tar"
go_import_path="github.com/bavanchun/ariadnev-shell/core"
go_package="${go_import_path}/cmd/advs"
go_build_tags="distro_binary withshell"
go_ldflags="-X main.Version=${version}"
short_desc="AriadnevShell — Material 3 desktop shell for Wayland (git variant)"
maintainer="bavanchun <bavanchun.US@gmail.com>"
license="MIT"
homepage="https://github.com/bavanchun/ariadnev-shell"
# CI populates distfiles/checksum dynamically; these are placeholders.
distfiles="https://github.com/bavanchun/ariadnev-shell/archive/refs/tags/v${version}.tar.gz"
checksum=badbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadb

# Conflicts and provides
conflicts="advs"
provides="advs-${version}_${revision}"

# Optional feature deps are listed in distro/void/README.md.
depends="quickshell accountsservice matugen dbus elogind"

pre_build() {
	make sync-shell
}

post_install() {
	# Desktop entry + icon
	vinstall "${wrksrc}/assets/advs-open.desktop" 644 usr/share/applications
	vinstall "${wrksrc}/assets/dev.vchun.ariadnev.desktop" 644 usr/share/applications
	vinstall "${wrksrc}/assets/dev.vchun.ariadnev.notepad.desktop" 644 usr/share/applications
	vinstall "${wrksrc}/assets/advlogo.svg" 644 usr/share/icons/hicolor/scalable/apps

	# Shell completions (generated by the built binary; skip when cross-building)
	vmkdir usr/share/bash-completion/completions
	vmkdir usr/share/zsh/site-functions
	vmkdir usr/share/fish/vendor_completions.d
	if [ -z "$CROSS_BUILD" ]; then
		"${DESTDIR}/usr/bin/advs" completion bash > "${DESTDIR}/usr/share/bash-completion/completions/advs"
		"${DESTDIR}/usr/bin/advs" completion zsh  > "${DESTDIR}/usr/share/zsh/site-functions/_advs"
		"${DESTDIR}/usr/bin/advs" completion fish > "${DESTDIR}/usr/share/fish/vendor_completions.d/advs.fish"
	fi

	vlicense "${wrksrc}/LICENSE"
}
