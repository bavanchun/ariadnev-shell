#!/usr/bin/make -f

export DH_VERBOSE = 1

# Extract version from debian/changelog
DEB_VERSION := $(shell dpkg-parsechangelog -S Version)
# Get upstream version (strip -1ppa1 suffix)
UPSTREAM_VERSION := $(shell echo $(DEB_VERSION) | sed 's/-[^-]*$$//')
# Strip ppa suffix and handle git versions
# Examples: 0.5.2ppa9 -> 0.5.2, 0.5.2+git20251116 -> 0.5.2
BASE_VERSION := $(shell echo $(UPSTREAM_VERSION) | sed 's/ppa[0-9]*$$//' | sed 's/+git.*//')

%:
	dh $@

override_dh_installsystemd:
	dh_installsystemd --name=advs

override_dh_auto_build:
	# All files are included in source package (downloaded by build-source.sh)
	# Launchpad build environment has no internet access
	$(eval DEB_HOST_ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH))
	@echo "Building for architecture: $(DEB_HOST_ARCH)"

	test -f advs-distropkg-$(DEB_HOST_ARCH).gz || (echo "ERROR: advs-distropkg-$(DEB_HOST_ARCH).gz not found!" && exit 1)
	test -f advs-source.tar.gz || (echo "ERROR: advs-source.tar.gz not found!" && exit 1)

	# Extract pre-built binary
	gunzip -c advs-distropkg-$(DEB_HOST_ARCH).gz > advs
	chmod +x advs

	# Extract source tarball for QML files
	tar -xzf advs-source.tar.gz
	# Find the extracted directory (it might have various names)
	# and rename it to the expected BASE_VERSION name for consistent install
	SOURCE_DIR=$$(find . -maxdepth 1 -type d -name "AriadnevShell-*" ! -name "AriadnevShell-$(BASE_VERSION)" | head -n1); \
	if [ -n "$$SOURCE_DIR" ] && [ "$$SOURCE_DIR" != "./AriadnevShell-$(BASE_VERSION)" ]; then \
		echo "Renaming $$SOURCE_DIR to AriadnevShell-$(BASE_VERSION)"; \
		mv "$$SOURCE_DIR" AriadnevShell-$(BASE_VERSION); \
	elif [ ! -d "AriadnevShell-$(BASE_VERSION)" ]; then \
		echo "ERROR: No AriadnevShell directory found after extraction!"; \
		ls -la; \
		exit 1; \
	fi

override_dh_auto_install:
	# Install binary
	install -Dm755 advs debian/advs/usr/bin/advs

	# Install systemd user service (before copying everything else)
	install -Dm644 AriadnevShell-$(BASE_VERSION)/assets/systemd/advs.service \
		debian/advs/usr/lib/systemd/user/advs.service

	# Install desktop file and icon
	install -Dm644 AriadnevShell-$(BASE_VERSION)/assets/advs-open.desktop \
		debian/advs/usr/share/applications/advs-open.desktop
	install -Dm644 AriadnevShell-$(BASE_VERSION)/assets/dev.vchun.ariadnev.desktop \
		debian/advs/usr/share/applications/dev.vchun.ariadnev.desktop
	install -Dm644 AriadnevShell-$(BASE_VERSION)/assets/dev.vchun.ariadnev.notepad.desktop \
		debian/advs/usr/share/applications/dev.vchun.ariadnev.notepad.desktop
	install -Dm644 AriadnevShell-$(BASE_VERSION)/assets/advlogo.svg \
		debian/advs/usr/share/icons/hicolor/scalable/apps/advlogo.svg

	# Install QML files from source tarball
	mkdir -p debian/advs/usr/share/quickshell/ariadnev
	cp -rL AriadnevShell-$(BASE_VERSION)/* debian/advs/usr/share/quickshell/ariadnev/

	# Remove unnecessary directories
	rm -rf debian/advs/usr/share/quickshell/ariadnev/core
	rm -rf debian/advs/usr/share/quickshell/ariadnev/distro
	rm -rf debian/advs/usr/share/quickshell/ariadnev/assets

	# Create VERSION file for Quickshell (stable release format)
	echo "$(BASE_VERSION)" > debian/advs/usr/share/quickshell/ariadnev/VERSION

	# Generate and install shell completions (if applicable)
	# Uncomment if advs supports completion generation
	# ./advs completion bash > advs.bash
	# ./advs completion zsh > advs.zsh
	# install -Dm644 advs.bash debian/advs/usr/share/bash-completion/completions/advs
	# install -Dm644 advs.zsh debian/advs/usr/share/zsh/vendor-completions/_advs

override_dh_auto_clean:
	rm -f advs
	rm -rf AriadnevShell-*
	# Don't remove advs-distropkg-amd64.gz and advs-source.tar.gz
	# They need to be included in the source package for Launchpad builds
	dh_auto_clean
