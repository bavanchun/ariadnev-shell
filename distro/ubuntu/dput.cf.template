# dput configuration for bavanchun ADVS PPAs
# Copy this to ~/.dput.cf (or merge with existing ~/.dput.cf)
#
# Usage:
#   dput ppa:bavanchun/advs ../package_version_source.changes
#   dput ppa:bavanchun/advs-git ../package_version_source.changes

# Stable ADVS PPA - for release versions
[ppa:bavanchun/advs]
fqdn = ppa.launchpad.net
method = ftp
incoming = ~bavanchun/ubuntu/advs/
login = anonymous
allow_unsigned_uploads = 0

# Nightly/Git ADVS PPA - for development builds
[ppa:bavanchun/advs-git]
fqdn = ppa.launchpad.net
method = ftp
incoming = ~bavanchun/ubuntu/advs-git/
login = anonymous
allow_unsigned_uploads = 0

# Alternative: Use HTTPS instead of FTP (more reliable through firewalls)
# Uncomment these if FTP doesn't work:
#
# [ppa:bavanchun/advs-https]
# fqdn = ppa.launchpad.net
# method = https
# incoming = ~bavanchun/ubuntu/advs/
# login = anonymous
# allow_unsigned_uploads = 0
#
# [ppa:bavanchun/advs-git-https]
# fqdn = ppa.launchpad.net
# method = https
# incoming = ~bavanchun/ubuntu/advs-git/
# login = anonymous
# allow_unsigned_uploads = 0

# Notes:
# - allow_unsigned_uploads = 0 enforces GPG signing (required by Launchpad)
# - anonymous login is standard for PPA uploads
# - The incoming path must match your Launchpad username and PPA name
