#!/usr/bin/make -f

export DH_VERBOSE = 1

# Get git commit date for version
GIT_DATE := $(shell date +%Y%m%d)
GIT_COMMIT := HEAD

# Go needs writable directories for its caches
export HOME := $(CURDIR)/debian/tmp-home
export GOCACHE := $(CURDIR)/debian/tmp-home/go-cache
export GOMODCACHE := $(CURDIR)/debian/tmp-home/go-mod

# Launchpad has no network access, so use local toolchain only
export GOTOOLCHAIN := local

%:
	dh $@

override_dh_installsystemd:
	dh_installsystemd --name=advs

override_dh_auto_build:
	# Create Go cache directories (sbuild sets HOME to non-existent path)
	mkdir -p $(HOME) $(GOCACHE) $(GOMODCACHE)

	# Git source is already included in source package (cloned by ppa-build.sh)
	# Launchpad build environment has no internet access
	test -d advs-git-repo || (echo "ERROR: advs-git-repo directory not found!" && exit 1)

	# Patch go.mod for Launchpad: align go directive w/latest Go toolchain
	GO_VERSION=$$(go env GOVERSION | sed -E 's/^go([0-9]+\.[0-9]+).*/\1/'); \
	if [ -n "$$GO_VERSION" ]; then \
		sed -E -i "s/^go 1\.[0-9]+(\.[0-9]+)?/go $$GO_VERSION/" advs-git-repo/core/go.mod; \
		if [ -f advs-git-repo/core/vendor/modules.txt ]; then \
			sed -E -i "s/^(## explicit; go )1\.[0-9]+(\.[0-9]+)?$$/\1$$GO_VERSION/" advs-git-repo/core/vendor/modules.txt; \
		fi; \
	else \
		echo "Warning: Could not detect Go version, leaving go.mod go directive unchanged"; \
	fi
	sed -E -i '/^toolchain go[0-9.]+$$/d' advs-git-repo/core/go.mod

	# Build advs-cli from source
	# Detect architecture
	$(eval DEB_HOST_ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH))
	@if [ -f advs-git-repo/.advs-version ]; then \
		. advs-git-repo/.advs-version; \
		echo "Building with VERSION=$$VERSION COMMIT=$$COMMIT ARCH=$(DEB_HOST_ARCH)"; \
		cd advs-git-repo/core && $(MAKE) GOFLAGS="-mod=vendor" dist ARCH=$(DEB_HOST_ARCH) VERSION="$$VERSION" COMMIT="$$COMMIT"; \
	else \
		echo "Warning: .advs-version not found, building without version info"; \
		cd advs-git-repo/core && $(MAKE) GOFLAGS="-mod=vendor" dist ARCH=$(DEB_HOST_ARCH); \
	fi
	cp advs-git-repo/core/bin/advs-linux-$(DEB_HOST_ARCH) advs
	chmod +x advs

override_dh_auto_install:
	# Install binary
	install -Dm755 advs debian/advs-git/usr/bin/advs

	# Install systemd user service
	install -Dm644 advs-git-repo/assets/systemd/advs.service \
		debian/advs-git/usr/lib/systemd/user/advs.service

	# Install desktop file and icon
	install -Dm644 advs-git-repo/assets/advs-open.desktop \
		debian/advs-git/usr/share/applications/advs-open.desktop
	install -Dm644 advs-git-repo/assets/dev.vchun.ariadnev.desktop \
		debian/advs-git/usr/share/applications/dev.vchun.ariadnev.desktop
	install -Dm644 advs-git-repo/assets/dev.vchun.ariadnev.notepad.desktop \
		debian/advs-git/usr/share/applications/dev.vchun.ariadnev.notepad.desktop
	install -Dm644 advs-git-repo/assets/advlogo.svg \
		debian/advs-git/usr/share/icons/hicolor/scalable/apps/advlogo.svg

override_dh_auto_clean:
	# Don't delete advs-git-repo directory - it's part of the source package (native format)
	# Clean up build artifacts
	rm -f advs
	rm -rf advs-git-repo/core/bin
	rm -rf debian/tmp-home
	dh_auto_clean
